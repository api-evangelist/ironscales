                "description": "Array of tag names"
              },
              {
                "name": "first_name",
                "value": "",
                "type": "query"
              },
              {
                "name": "last_name",
                "value": "",
                "type": "query"
              },
              {
                "name": "department",
                "value": "",
                "type": "query"
              },
              {
                "name": "email",
                "value": "",
                "type": "query"
              },
              {
                "name": "title",
                "value": "",
                "type": "query"
              },
              {
                "name": "is_protected",
                "value": "",
                "type": "query"
              },
              {
                "name": "language",
                "value": "",
                "type": "query",
                "description": "Language full name"
              },
              {
                "name": "awareness",
                "value": "",
                "type": "query",
                "description": "0 - Beginner Level, 1 - Mid Level, 2 - Expert Level"
              },
              {
                "name": "sort",
                "value": "",
                "type": "query"
              },
              {
                "name": "order",
                "value": "",
                "type": "query"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page Number"
              },
              {
                "name": "items_per_page",
                "value": "",
                "type": "query",
                "description": "Number of items per page (optional, overrides default)"
              }
            ]
          },
          "docs": "List of a company mailboxes\n<br/><b>Scopes:</b>\n<ul>\n<li>partner.all</li>\n<li>company.all</li>\n<li>partner.company.view</li>\n<li>company.view</li>\n</ul>\n\nAll filters with string values are case-insensitive"
        },
        {
          "info": {
            "name": "Bulk edit of a company mailboxes",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://appapi.ironscales.com/appapi/mailboxes/:company_id/list/",
            "params": [
              {
                "name": "company_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "List of a company mailboxes\n<br/><b>Scopes:</b>\n<ul>\n<li>partner.all</li>\n<li>company.all</li>\n<li>partner.company.edit</li>\n<li>company.edit</li>\n</ul>\n\nTags manipulation - both adding and deletion - is performed asynchronously by background task.\nThe result of these operations may be not available immediately after getting a response."
        },
        {
