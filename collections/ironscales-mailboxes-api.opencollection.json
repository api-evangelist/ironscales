{
  "opencollection": "1.0.0",
  "info": {
    "name": "IRONSCALES Management Mailboxes API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Mailboxes",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get compliance report",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://appapi.ironscales.com/appapi/mailboxes/:company_id/compliance-report/",
            "params": [
              {
                "name": "company_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "period",
                "value": "",
                "type": "query",
                "description": "\nPeriod to filter the campaigns by:\n<ul>\n    <li>1 - Last 7 days</li>\n    <li>2 - Last year</li>\n    <li>3 - Last 3 month</li>\n    <li>4 - Last 6 month</li>\n    <li>5 - Custom range (up to 180d) - MM-DD-YYYY - MM-DD-YYYY</li>\n</ul>\n"
              },
              {
                "name": "customPeriodFrom",
                "value": "",
                "type": "query",
                "description": "Start date of the custom period in MM-DD-YYYY format"
              },
              {
                "name": "customPeriodTo",
                "value": "",
                "type": "query",
                "description": "End date of the custom period in MM-DD-YYYY format"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number"
              }
            ]
          },
          "docs": "Compliance report for a company per user\n<br/><b>Scopes:</b>\n<ul>\n<li>partner.all</li>\n<li>company.all</li>\n<li>partner.company.view</li>\n<li>company.view</li>\n</ul>"
        },
        {
          "info": {
            "name": "List of a company mailboxes",
            "type": "http"
